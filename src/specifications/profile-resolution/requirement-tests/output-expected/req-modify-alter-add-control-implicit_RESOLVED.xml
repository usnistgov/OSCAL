<?xml version="1.0" encoding="UTF-8"?>
<catalog xmlns="http://csrc.nist.gov/ns/oscal/1.0"
          uuid="00000000-0000-4000-B000-000000000000">
   <metadata>
      <title>Test Profile: add child controls, implicit binding</title>
      <last-modified>2026-11-14T00:00:00Z</last-modified>
      <version>1.0</version>
      <oscal-version>1.2.3</oscal-version>
      <prop name="resolution-tool"
             value="OSCAL Profile Resolver XSLT Pipeline OPRXP"/>
      <link href="../req-modify-alter-add-control-implicit.xml"
             rel="source-profile"/>
   </metadata>
   <group id="ac">
      <title>Access Control</title>
      <control id="ac-1">
         <title>Policy and Procedures</title>
         <param id="ac-1_prm_1">
            <label>frequency</label>
         </param>
         <prop name="label" value="AC-1"/>
         <link href="#ac-2" rel="related"/>
         <part name="statement" id="ac-1_smt">
            <p>Review and update the access control policy <insert type="param" id-ref="ac-1_prm_1"/>.</p>
         </part>
         <control id="ac-1.100">
            <title>Organization-Defined Policy Review</title>
            <prop name="label" value="AC-1(100)"/>
            <part name="statement" id="ac-1.100_smt">
               <p>Review the policy after each significant change.</p>
            </part>
         </control>
      </control>
      <control id="ac-2">
         <title>Account Management</title>
         <param id="ac-2_prm_1">
            <label>account types</label>
         </param>
         <prop name="tailoring" ns="https://example.org/ns/oscal" value="extended"/>
         <prop name="label" value="AC-2"/>
         <part name="statement" id="ac-2_smt">
            <p>Define and document the types of accounts allowed: <insert type="param" id-ref="ac-2_prm_1"/>.</p>
         </part>
         <part name="guidance" id="ac-2_gdn">
            <p>Account management includes the identification of account types.</p>
         </part>
         <control id="ac-2.100">
            <title>Account Inventory</title>
            <param id="ac-2.100_prm_1">
               <label>inventory frequency</label>
            </param>
            <prop name="label" value="AC-2(100)"/>
            <part name="statement" id="ac-2.100_smt">
               <p>Maintain an inventory of accounts <insert type="param" id-ref="ac-2.100_prm_1"/>.</p>
            </part>
         </control>
         <control id="ac-2.101">
            <title>Shared Account Approval</title>
            <prop name="label" value="AC-2(101)"/>
            <part name="statement" id="ac-2.101_smt">
               <p>Approve shared accounts before activation.</p>
            </part>
         </control>
         <control id="ac-2.1">
            <title>Automated System Account Management</title>
            <prop name="label" value="AC-2(1)"/>
            <part name="statement" id="ac-2.1_smt">
               <p>Support the management of system accounts using automated mechanisms.</p>
            </part>
         </control>
         <control id="ac-2.2">
            <title>Automated Temporary and Emergency Account Management</title>
            <prop name="label" value="AC-2(2)"/>
            <part name="statement" id="ac-2.2_smt">
               <p>Automatically remove temporary and emergency accounts.</p>
            </part>
         </control>
         <control id="ac-2.102">
            <title>Account Review Evidence</title>
            <prop name="label" value="AC-2(102)"/>
            <part name="statement" id="ac-2.102_smt">
               <p>Retain evidence of account reviews.</p>
            </part>
         </control>
      </control>
   </group>
</catalog>
